version: 1
app: sglang-serve
gpu: RTX 4090
num_gpus: 1
cpu_cores: 8
ram_gb: 32
disk_gb: 80
inet_down_mbps: 500
max_dph: 2.5
verified_only: true
# Official SGLang image: CUDA + torch + SGLang + toolchain preinstalled.
image: lmsysorg/sglang:v0.5.17-cu129
label: sglang-qwen3.5-4b
app_port: 30000
work_dir: .
auto_attach: true

init_cmd: |
  #!/usr/bin/env bash
  # Prefetch model weights (optional — SGLang can also download on first start).
  set -euo pipefail
  export HF_HOME="${HF_HOME:-$PWD/.hf_cache}"
  export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-$HF_HOME/hub}"
  mkdir -p "$HUGGINGFACE_HUB_CACHE"
  MODEL="${MODEL:-Qwen/Qwen3.5-4B}"
  echo "[init] prefetch $MODEL → $HUGGINGFACE_HUB_CACHE"
  python3 - <<PY
  from huggingface_hub import snapshot_download
  import os
  print(snapshot_download(os.environ.get("MODEL", "Qwen/Qwen3.5-4B")))
  PY
  echo "[init] done"

start: |
  #!/usr/bin/env bash
  # OpenAI-compatible server. Image is lmsysorg/sglang — SGLang is already installed.
  set -euo pipefail
  export HF_HOME="${HF_HOME:-$PWD/.hf_cache}"
  export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-$HF_HOME/hub}"
  PORT="${PORT:-30000}"
  MODEL="${MODEL:-Qwen/Qwen3.5-4B}"
  echo "[start] sglang serve $MODEL :$PORT"
  exec python3 -m sglang.launch_server \
    --model-path "$MODEL" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --context-length "${CONTEXT_LENGTH:-2048}" \
    --mem-fraction-static "${MEM_FRACTION_STATIC:-0.85}" \
    --trust-remote-code
