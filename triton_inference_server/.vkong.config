version: 1
app: triton-inference-server
gpu: RTX 4090
num_gpus: 1
cpu_cores: 4
ram_gb: 16
disk_gb: 40
inet_down_mbps: 500
max_dph: 2.5
verified_only: true
# Official Triton Inference Server — full image (ONNX, PyTorch, TensorRT, Python backends).
image: nvcr.io/nvidia/tritonserver:26.07-py3
label: triton-mobilenetv2
app_port: 8000
work_dir: .
auto_attach: true

init_cmd: |
  #!/usr/bin/env bash
  set -euo pipefail
  pip install huggingface_hub
  python3 -c "
  from huggingface_hub import hf_hub_download
  path = hf_hub_download('onnx-community/mobilenet_v2_1.0_224', 'onnx/model.onnx')
  import shutil, os
  dst = 'models/mobilenetv2/1/model.onnx'
  os.makedirs(os.path.dirname(dst), exist_ok=True)
  shutil.copy(path, dst)
  print(f'[init] {dst} ready ({os.path.getsize(dst)/1e6:.1f} MB)')
  "

start: |
  #!/usr/bin/env bash
  set -euo pipefail
  PORT="${PORT:-8000}"
  echo "[start] tritonserver --model-repository=models :$PORT"
  exec /opt/tritonserver/bin/tritonserver \
    --model-repository=models \
    --http-port "$PORT" \
    --grpc-port 8001 \
    --metrics-port 8002 \
    --log-verbose 0
