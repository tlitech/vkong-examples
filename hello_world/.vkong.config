version: 1
gpu: Any
num_gpus: 0
cpu_cores: 2
ram_gb: 4
disk_gb: 16
inet_down_mbps: 0
max_dph: 0.5
verified_only: true
image: ubuntu:24.04
label: hello-world
app_port: 8000
work_dir: .
auto_attach: true

init_cmd: |
  #!/usr/bin/env bash
  set -euo pipefail
  export DEBIAN_FRONTEND=noninteractive
  echo "[init] hello on $(uname -a)"
  need_pkgs=0
  if ! command -v python3 >/dev/null 2>&1; then need_pkgs=1
  elif ! python3 -m pip --version >/dev/null 2>&1; then need_pkgs=1
  fi
  if [ "$need_pkgs" = 1 ]; then
    echo "[init] installing python3 + pip…"
    apt-get update -qq
    apt-get install -y -qq python3 python3-pip ca-certificates
  fi
  echo "[init] python=$(command -v python3) $(python3 --version 2>&1)"
  python3 -m pip install --break-system-packages -q -r requirements.txt
  echo "[init] done"

start: |
  #!/usr/bin/env bash
  set -euo pipefail
  PORT="${PORT:-8000}"
  echo "[start] hello on 0.0.0.0:${PORT}"
  exec python3 -m uvicorn main:app --host 0.0.0.0 --port "$PORT"
